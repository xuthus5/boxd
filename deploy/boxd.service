[Unit]
Description=boxd control plane and sing-box data plane
Documentation=https://github.com/xuthus5/boxd
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/boxd -data-dir /var/lib/boxd -web -listen [::]:7662 -start
WorkingDirectory=/var/lib/boxd
Environment=HOME=/var/lib/boxd
StateDirectory=boxd
StateDirectoryMode=0750
RuntimeDirectory=boxd
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=1048576
UMask=0077

# Keep /dev/net/tun available for the optional TUN inbound.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
