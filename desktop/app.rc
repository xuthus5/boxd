#include "winuser.h"

// 应用图标 (IDI_ICON1 = 1)
1 ICON "build\\boxd-desktop.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "boxd developers"
            VALUE "FileDescription", "boxd-desktop"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "boxd-desktop"
            VALUE "OriginalFilename", "boxd-desktop.exe"
            VALUE "ProductName", "boxd-desktop"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
